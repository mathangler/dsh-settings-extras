{
  "name": "dsh-settings-extras",
  "version": "0.1.1",
  "description": "A DeepSeek Harness plugin for the Settings dialog: a Skills panel (browse, search and install from skills.sh, toggle model invocation per skill), a token-usage dashboard (lifetime totals, daily heatmap, per-model trends) and a live Web search on/off switch that withholds the web_search tool from every agent.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/parts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "skills",
    "skills.sh",
    "token",
    "usage",
    "statistics",
    "web-search",
    "web_search",
    "toggle"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "uiWorkspace"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
